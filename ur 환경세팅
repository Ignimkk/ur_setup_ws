--------- 실행 명령어 ---------
1. 가제보, 무브잇, UR+robotiq+realsense 브링업
ros2 launch ur_setup_bringup ur_sim_moveit_robotiq_ur16e.launch.py 

2. pnp 실행 
# trigger_mode=0: pick_goal만 받아도 실행
ros2 launch pick_place_module pick_place.launch.py trigger_mode:=0
# trigger_mode=1: pick+place 모두 받아야 실행
ros2 launch pick_place_module pick_place.launch.py trigger_mode:=1
# logger 비활성
ros2 launch pick_place_module pick_place.launch.py enable_logger:=false

2-1 pnp + trajectroy client
ros2 run pick_place_module pick_place_node --ros-args   -p use_trajopt:=true   -p use_sim_time:=true   --params-file /opt/ros/humble/share/ur_moveit_config/config/kinematics.yaml



3. ee의 xyz 좌표 확인하기 
ros2 run pick_place_module ee_pose_publisher 

4. 경로를 time-waypoints로 분할하기
ros2 run pick_place_module rrt_path_recorder_node

5. rviz2에 경로 및 궤적 시각화 rviz2에서 path - pland, actual display에 추가하기

ros2 run pick_place_module ee_path_visualizer_node


6. trajectory opitimization server
mk@mk:~/dev_ws/robot_arm/UR/trajopt_ws$ ros2 run trajopt_validation trajopt_server_node


7. 장애물 command spawn/remove
# URDF의 testbed_obstacle_link는 기본 비활성화되어 있음.
# 크기: 0.05 x 0.30 x 0.40 [m]
# plate_left와 plate_right 사이: world 기준 x=0.0, y=0.35, z=1.0
# 로봇에서 10 m 떨어진 위치: world 기준 x=10.0, y=0.35, z=1.0

# Gazebo spawn: plate 사이
ros2 run ros_gz_sim create \
  -file $(ros2 pkg prefix ur_setup_bringup)/share/ur_setup_bringup/models/testbed_obstacle/model.sdf \
  -name testbed_obstacle \
  -x 0.0 -y 0.35 -z 1.0

# Gazebo spawn: 로봇에서 10 m 떨어진 위치
ros2 run ros_gz_sim create \
  -file $(ros2 pkg prefix ur_setup_bringup)/share/ur_setup_bringup/models/testbed_obstacle/model.sdf \
  -name testbed_obstacle \
  -x 10.0 -y 0.35 -z 1.0

# Gazebo remove
ign service -s /world/testbed_world/remove \
  --reqtype ignition.msgs.Entity \
  --reptype ignition.msgs.Boolean \
  --timeout 1000 \
  --req 'name: "testbed_obstacle", type: MODEL'

# MoveIt PlanningScene add: plate 사이
ros2 topic pub --once /collision_object moveit_msgs/msg/CollisionObject "{header: {frame_id: 'world'}, id: 'testbed_obstacle', primitives: [{type: 1, dimensions: [0.05, 0.30, 0.40]}], primitive_poses: [{position: {x: 0.0, y: 0.35, z: 1.0}, orientation: {w: 1.0}}], operation: 0}"

# MoveIt PlanningScene add: 로봇에서 10 m 떨어진 위치
ros2 topic pub --once /collision_object moveit_msgs/msg/CollisionObject "{header: {frame_id: 'world'}, id: 'testbed_obstacle', primitives: [{type: 1, dimensions: [0.05, 0.30, 0.40]}], primitive_poses: [{position: {x: 10.0, y: 0.35, z: 1.0}, orientation: {w: 1.0}}], operation: 0}"

# MoveIt PlanningScene remove
ros2 topic pub --once /collision_object moveit_msgs/msg/CollisionObject "{header: {frame_id: 'world'}, id: 'testbed_obstacle', operation: 1}"


